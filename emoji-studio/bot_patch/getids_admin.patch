+ID_LIST_RE = re.compile(r"^\s*(\d{15,20}\s*)+$")
+
+
+async def _send_sources_by_ids(message: Message, bot: Bot, raw: str) -> None:
+    """Отдаёт zip с исходными .tgs/.webp/.webm для любых custom emoji ID из текста (для приложения на ПК)."""
+    ids = list(dict.fromkeys(re.findall(r"\d{15,20}", raw)))[:200]
+    if not ids:
+        await message.answer("Пришлите ID эмодзи (15–20 цифр), по одному на строку.")
+        return
+    meta = await _ensure_sources(bot, ids)
+    archive = config.TMP_DIR / "sources_custom.zip"
+    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as z:
+        for eid in ids:
+            info = meta.get(eid)
+            if info:
+                z.write(config.CACHE_DIR / info["file"], arcname=info["file"])
+    missing = [i for i in ids if i not in meta]
+    caption = f"Исходные эмодзи: {len(ids) - len(missing)} из {len(ids)}"
+    if missing:
+        caption += "\nНе найдены: " + ", ".join(missing)
+    await message.answer_document(FSInputFile(archive), caption=caption[:1024])
+
+
+@router.message(Command("getids"))
+async def getids(message: Message, bot: Bot, command: CommandObject) -> None:
+    """/getids <ID> <ID> … — исходники для Emoji Studio (только администраторы)."""
+    if message.from_user is None or message.from_user.id not in config.ADMIN_IDS:
+        return
+    await _send_sources_by_ids(message, bot, command.args or "")
+
+
+@router.message(F.text.regexp(ID_LIST_RE))
+async def getids_plain(message: Message, bot: Bot) -> None:
+    """Сообщение только из ID (например, вставленные из приложения) — тоже отдаём исходники."""
+    if message.from_user is None or message.from_user.id not in config.ADMIN_IDS:
+        return
+    await _send_sources_by_ids(message, bot, message.text or "")
+
